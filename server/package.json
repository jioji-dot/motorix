{
  "name": "motorix-server",
  "version": "1.0.0",
  "description": "API REST de Motorix, Sistema de Gestión para Taller Mecánico",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file=../.env server.js",
    "dev": "node --watch --env-file=../.env server.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "db:migrate": "node --env-file=../.env scripts/migrate.js",
    "db:seed": "node --env-file=../.env scripts/seed.js",
    "db:reset": "node --env-file=../.env scripts/reset-db.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "jest": "^30.0.0",
    "supertest": "^7.1.0"
  }
}
