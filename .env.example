# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.

# Base de datos MySQL local
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=motorix
DB_NAME_TEST=motorix_test

# Sesión (JWT)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Servidor
PORT=3000
# Dirección pública de la API (opcional; por defecto se usa la de la petición)
PUBLIC_API_URL=

# Datos del taller para el ticket (opcionales; tienen valores por defecto)
WORKSHOP_NAME=
WORKSHOP_ADDRESS=
WORKSHOP_PHONE=

# Mercado Pago, modo de pruebas (sandbox). Usa credenciales de PRUEBA; nunca las subas al repositorio.
MP_ACCESS_TOKEN=
# Secreto para validar la firma de las notificaciones (opcional)
MP_WEBHOOK_SECRET=
# Dirección pública para las notificaciones (opcional en local; sin ella se usa "Actualizar estado")
MP_NOTIFICATION_URL=

# Contraseñas de las cuentas iniciales de prueba (solo entorno local; ver docs/project-context.md)
SEED_PASSWORD_ADMIN=
SEED_PASSWORD_RECEPCION=
SEED_PASSWORD_MECANICO=
