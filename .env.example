# Plantilla de variables de entorno de Motorix.
# Copia este archivo a `.env` y completa los valores. NUNCA subas `.env` al repositorio.

# --- Servidor ---
# Puerto en el que escucha la API
PORT=3000
# Entorno de ejecución: development | test | production
NODE_ENV=development

# Orígenes permitidos por CORS, separados por comas (opcional). Si se omite, en desarrollo se
# permite cualquier origen localhost (necesario para ejecutar la app Flutter en el navegador).
CORS_ORIGIN=

# --- Base de datos MySQL local ---
# Host de MySQL
DB_HOST=localhost
# Puerto de MySQL
DB_PORT=3306
# Usuario dedicado del proyecto (motorix_app); NUNCA uses root
DB_USER=
# Contraseña del usuario dedicado
DB_PASSWORD=
# Nombre de la base de datos (motorix; las pruebas usan motorix_test)
DB_NAME=motorix

# --- Autenticación ---
# Secreto para firmar los JWT (cadena larga y aleatoria)
JWT_SECRET=
# Vigencia de la sesión
JWT_EXPIRES_IN=8h

# --- Contraseñas iniciales para los seeds (solo entorno local) ---
# Los valores del estándar del MVP están en docs/project-context.md
SEED_ADMIN_PASSWORD=
SEED_RECEPTION_PASSWORD=
SEED_MECHANIC_PASSWORD=

# --- Mercado Pago (opcional; solo modo de pruebas en el MVP) ---
# Token de acceso de las credenciales de PRUEBAS de tu aplicación en Mercado Pago.
# Sin este valor el cobro digital responde un mensaje claro y los demás métodos siguen funcionando.
# NUNCA lo escribas en el repositorio ni lo compartas.
MP_ACCESS_TOKEN=
# URL base de la API (opcional; por omisión https://api.mercadopago.com)
MP_API_URL=
# Modo: sandbox (enlace de pruebas, valor por omisión) o production
MP_MODE=sandbox
# Tiempo máximo de espera de cada llamada, en milisegundos (opcional; por omisión 10000)
MP_TIMEOUT_MS=
